# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored — never commit real keys.

# --- Required ---
# https://build.nvidia.com — used for both outline and dialogue passes.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# https://console.groq.com — used for PlayAI TTS.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional overrides (defaults shown) ---
# OUTLINE_MODEL=deepseek-ai/deepseek-v3.1
# SCRIPT_MODEL=deepseek-ai/deepseek-v3.1
# GROQ_TTS_MODEL=playai-tts
# HOST_VOICE=Celeste-PlayAI
# EXPERT_VOICE=Fritz-PlayAI
