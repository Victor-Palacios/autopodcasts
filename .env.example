# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored — never commit real keys.

# --- Required ---
# https://build.nvidia.com — used for both outline and dialogue passes.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# https://console.groq.com — used for PlayAI TTS.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional overrides (defaults shown) ---
# Browse https://build.nvidia.com/models for newer NVIDIA model IDs.
# OUTLINE_MODEL=deepseek-ai/deepseek-v4-flash
# SCRIPT_MODEL=deepseek-ai/deepseek-v4-flash
#
# Groq TTS — playai-tts was retired 2025-12-31. Use Orpheus.
# Voices: autumn, diana, hannah, austin, daniel, troy.
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# HOST_VOICE=hannah
# EXPERT_VOICE=daniel
